# PostgreSQL connection string (SQLAlchemy, psycopg 3 driver).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/contextual_rag

# Chunking configuration (approximate tokens).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Upload configuration.
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=20

# OpenRouter LLM provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# Embedding configuration.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MUST match the dimensionality of EMBEDDING_MODEL.
EMBEDDING_DIM=384

# Database used by the test suite (create it locally, e.g. via docker compose).
TEST_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/contextual_rag_test

# Application.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO